<% content_for :title, "Регистрация" %>

<div class="container-page flex justify-center py-12 sm:py-20">
  <div class="w-full max-w-md">
    <%= render "devise/shared/auth_header", title: "Создайте аккаунт",
          subtitle: safe_join(["Уже есть аккаунт? ", link_to("Войти", new_user_session_path, class: "font-semibold text-brand hover:opacity-80")]) %>

    <div class="card p-6 sm:p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset>
          <legend class="label">Кто вы?</legend>
          <div class="grid grid-cols-2 gap-3">
            <% [["visitor", "Посетитель", "Покупаю билеты", :ticket],
                ["organizer", "Организатор", "Провожу события", :sparkles]].each do |value, title, text, icon_name| %>
              <label class="option-card">
                <%= f.radio_button :role, value, class: "sr-only", checked: (resource.role.presence || "visitor") == value %>
                <%= icon(icon_name, css_class: "size-5") %>
                <span class="block font-display text-sm font-bold text-ink"><%= title %></span>
                <span class="block text-xs text-ink-3"><%= text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div>
          <%= f.label :name, "Имя", class: "label" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Как к вам обращаться", class: "input" %>
        </div>

        <div>
          <%= f.label :email, "Email", class: "label" %>
          <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "input" %>
        </div>

        <div>
          <%= f.label :password, "Пароль", class: "label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
          <% if @minimum_password_length %>
            <p class="hint">Минимум <%= ru_plural(@minimum_password_length, "символ", "символа", "символов") %></p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Повторите пароль", class: "label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
        </div>

        <%= f.submit "Зарегистрироваться", class: "btn btn-primary btn-lg btn-block" %>
      <% end %>
    </div>
  </div>
</div>

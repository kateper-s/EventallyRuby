<% content_for :title, "Профиль" %>

<div class="container-narrow py-12">
  <h1 class="heading-1">Профиль</h1>
  <p class="mt-1 text-ink-3">Имя, почта и пароль</p>

  <div class="card mt-6 p-6 sm:p-8">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :name, "Имя", class: "label" %>
          <%= f.text_field :name, autocomplete: "name", class: "input" %>
        </div>
        <div>
          <%= f.label :email, "Email", class: "label" %>
          <%= f.email_field :email, autocomplete: "email", class: "input" %>
        </div>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-warning"><%= icon(:info) %>Ожидает подтверждения: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="divider"></div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :password, "Новый пароль", class: "label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
          <p class="hint">Оставьте пустым, чтобы не менять</p>
        </div>
        <div>
          <%= f.label :password_confirmation, "Повторите пароль", class: "label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
        </div>
      </div>

      <div>
        <%= f.label :current_password, "Текущий пароль", class: "label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "input" %>
        <p class="hint">Нужен, чтобы подтвердить изменения</p>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Сохранить", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card mt-6 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="heading-3">Удалить аккаунт</h2>
      <p class="text-ink-3">Это действие нельзя отменить</p>
    </div>
    <%= button_to "Удалить аккаунт", registration_path(resource_name), method: :delete,
          class: "btn btn-secondary text-brand hover:border-brand",
          form: { data: { turbo_confirm: "Точно удалить аккаунт?" } } %>
  </div>
</div>

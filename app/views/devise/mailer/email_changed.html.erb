<h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#141210;">Email изменён</h1>
<p style="margin:0 0 16px;">Здравствуйте, <%= @resource.try(:name).presence || @email %>!</p>
<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0;">Адрес вашего аккаунта меняется на <%= @resource.unconfirmed_email %>.</p>
<% else %>
  <p style="margin:0;">Адрес вашего аккаунта изменён на <%= @resource.email %>.</p>
<% end %>

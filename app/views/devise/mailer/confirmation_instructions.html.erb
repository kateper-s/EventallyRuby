<h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#141210;">Подтверждение email</h1>
<p style="margin:0 0 24px;">Здравствуйте, <%= @email %>! Подтвердите адрес по ссылке:</p>
<p style="margin:0;"><%= link_to "Подтвердить email", confirmation_url(@resource, confirmation_token: @token),
      style: "display:inline-block;padding:12px 24px;background:#E8420D;color:#FFFFFF;text-decoration:none;border-radius:8px;font-weight:bold;" %></p>

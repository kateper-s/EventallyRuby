<header class="sticky top-0 z-50 border-b border-border bg-surface"
        data-controller="toggle"
        data-action="click@window->toggle#closeOnClickOutside keydown.esc@window->toggle#close turbo:before-cache@document->toggle#close">
  <div class="container-page flex h-16 items-center justify-between gap-4">

    <%= link_to root_path, class: "flex items-center gap-2 transition-opacity hover:opacity-80", "aria-label": "Eventally — на главную" do %>
      <span class="flex size-8 items-center justify-center rounded-control bg-brand font-display text-sm font-extrabold text-white">E</span>
      <span class="font-display text-lg font-extrabold tracking-tight text-ink">Eventally</span>
    <% end %>

    <nav class="hidden flex-1 items-center gap-1 md:flex" aria-label="Основное меню">
      <%= nav_link "События", root_path %>
      <% if user_signed_in? && current_user.organizer? %>
        <%= nav_link "Мои события", my_events_path %>
      <% else %>
        <%= nav_link "Организаторам", "#" %>
      <% end %>
    </nav>

    <div class="flex items-center gap-2">
      <% if user_signed_in? %>
        <% unless current_user.organizer? %>
          <%= link_to "Мои билеты", my_tickets_path, class: "btn btn-ghost hidden md:inline-flex" %>
        <% end %>

        <% if current_user.organizer? %>
          <%= link_to new_event_path, class: "btn btn-primary" do %>
            <%= icon(:plus) %><span class="hidden sm:inline">Создать</span>
          <% end %>
        <% end %>

        <div class="relative hidden md:block"
             data-controller="toggle"
             data-action="click@window->toggle#closeOnClickOutside keydown.esc@window->toggle#close turbo:before-cache@document->toggle#close">
          <button type="button" class="flex items-center gap-1.5 rounded-full p-0.5 pr-2 transition-colors hover:bg-canvas"
                  data-toggle-target="button" data-action="toggle#toggle"
                  aria-haspopup="menu" aria-expanded="false" aria-label="Меню пользователя">
            <%= avatar(current_user.name, size: :sm) %>
            <%= icon(:chevron_down, css_class: "size-4 text-ink-3") %>
          </button>

          <div class="dropdown-menu" role="menu" data-toggle-target="menu" hidden>
            <div class="px-3 pb-2 pt-1.5">
              <p class="truncate font-display text-sm font-bold text-ink"><%= current_user.name %></p>
              <p class="truncate text-xs text-ink-3"><%= current_user.email %></p>
            </div>
            <div class="divider my-1"></div>
            <%= link_to (current_user.organizer? ? my_events_path : my_tickets_path), class: "dropdown-item", role: "menuitem" do %>
              <%= icon(:ticket) %> <%= current_user.organizer? ? "Мои события" : "Мои билеты" %>
            <% end %>
            <%= link_to edit_user_registration_path, class: "dropdown-item", role: "menuitem" do %>
              <%= icon(:user) %> Профиль
            <% end %>
            <div class="divider my-1"></div>
            <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item", role: "menuitem" do %>
              <%= icon(:log_out) %> Выйти
            <% end %>
          </div>
        </div>
      <% else %>
        <%= link_to "Войти", new_user_session_path, class: "btn btn-ghost hidden md:inline-flex" %>
        <%= link_to new_user_registration_path, class: "btn btn-primary" do %>
          <%= icon(:plus) %><span>Создать</span>
        <% end %>
      <% end %>

      <button type="button" class="btn btn-ghost btn-icon md:hidden"
              data-toggle-target="button" data-action="toggle#toggle"
              aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню">
        <%= icon(:menu, css_class: "size-5") %>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="absolute inset-x-0 top-full border-b border-border bg-surface shadow-card-hover md:hidden"
       data-toggle-target="menu" hidden>
    <nav class="container-page flex flex-col gap-1 py-3" aria-label="Мобильное меню">
      <%= nav_link "События", root_path %>
      <% unless user_signed_in? && current_user.organizer? %>
        <%= nav_link "Организаторам", "#" %>
      <% end %>
      <div class="divider my-2"></div>
      <% if user_signed_in? %>
        <div class="flex items-center gap-3 px-3.5 py-2">
          <%= avatar(current_user.name, size: :sm) %>
          <div class="min-w-0">
            <p class="truncate font-display text-sm font-bold"><%= current_user.name %></p>
            <p class="truncate text-xs text-ink-3"><%= current_user.email %></p>
          </div>
        </div>
        <%= nav_link (current_user.organizer? ? "Мои события" : "Мои билеты"), (current_user.organizer? ? my_events_path : my_tickets_path), icon_name: :ticket %>
        <%= nav_link "Профиль", edit_user_registration_path, icon_name: :user %>
        <%= button_to destroy_user_session_path, method: :delete, class: "nav-link w-full" do %>
          <%= icon(:log_out) %> Выйти
        <% end %>
      <% else %>
        <%= link_to "Войти", new_user_session_path, class: "btn btn-secondary btn-block" %>
      <% end %>
    </nav>
  </div>
</header>

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Eventally — найди своё событие</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-ink font-body min-h-screen flex flex-col">
    <%= render "shared/navbar" %>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto mt-4 px-4 w-full">
        <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-card text-sm">
          <%= notice %>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="max-w-6xl mx-auto mt-4 px-4 w-full">
        <div class="bg-brand-muted border border-brand/20 text-brand px-4 py-3 rounded-card text-sm">
          <%= alert %>
        </div>
      </div>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>